# 复制为 env/.env 后修改；也可使用项目根目录 .env（Docker Compose 常用）

# ---------- 服务器配置 ----------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# 前置可信反向代理跳数：docker 部署默认单层 nginx（默认 1）；后端直接暴露公网时填 0
# TRUSTED_PROXY_HOPS=1

# ---------- 文档 / 运行模式 ----------
DEBUG=true
VERSION=3.1.0
DEMO_ENABLE=false

PROJECT_NAME=FastAPI Template
API_V1_STR=/api/v1
FRONTEND_HOST=http://localhost:5173
SECRET_KEY=changethis
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# ---------- 数据库配置：mysql | postgres | sqlite ----------
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=app
# 可选：直接写连接串，设置后覆盖上面分项
# DATABASE_URI=postgresql+psycopg://postgres:password@localhost:5432/app

# 初始化配置
AUTO_CREATE_TABLES=true
AUTO_SEED_ON_STARTUP=true
PLUGIN_PREFIX=fastadmin_

# ---------- Redis 配置 ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=your_redis_password
REDIS_DB_NAME=1
# REDIS_URI=redis://localhost:6379/1

# ---------- 日志 ----------
LOGGER_LEVEL=DEBUG
LOG_FILE_ENABLE=true
LOG_FILE_RETENTION_DAYS=7
# LOG_DIR=logs
# 文件日志：logs/app.log（按日轮转，gz 压缩，Loguru）

# ---------- 超级管理员 / 测试 ----------
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=Rebort12
EMAIL_TEST_USER=test@example.com

# ---------- 邮箱配置 ----------
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_TLS=false
SMTP_SSL=true
SMTP_USER=rebort.chen@howentech.com
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=rebort.chen@howentech.com
EMAILS_FROM_NAME=全栈 FastAPI 项目
